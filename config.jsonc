{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "ubuntu"
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    "break",
    "title",
    "separator",
    "break",
    "os",
    "kernel",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    {
      "type": "disk",
      "folders": ["/"]
    },
    {
      "type": "battery",
      "key": "Battery",
      "showName": false
    },
    "uptime",
    "break",
    "colors"
  ]
}